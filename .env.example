# Copy to .env and fill in. .env is gitignored.

# Groq API key (free: https://console.groq.com). Enables LLM extraction + judge.
# Without it, the API runs in dense-retrieval-only mode.
GROQ_API_KEY=

# Optional overrides (defaults shown)
# ENABLE_LLM=true
# EXTRACT_MODEL=llama-3.1-8b-instant
# JUDGE_MODEL=llama-3.3-70b-versatile
# ML_MODEL_TYPE=linear
# TOP_K=4
# JUDGE_WEIGHT=0.6
