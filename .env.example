# Candidate Ranking API - Environment Configuration

# Application Settings
ENVIRONMENT=development  # Options: development, staging, production
DEBUG=True

# Model Configuration
MODEL_TYPE=linear  # Options: linear, gboost
MODEL_DIR=app/ml/models

# API Settings
API_TITLE="Candidate Ranking API"
API_VERSION="1.0.0"
API_DESCRIPTION="ML-powered candidate ranking service"

# Logging
LOG_LEVEL=INFO  # Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FORMAT="%(asctime)s - %(name)s - %(levelname)s - %(message)s"

# NLP Configuration
NLP_MODEL_NAME="sentence-transformers/all-MiniLM-L6-v2"

# Rate Limiting (future use)
RATE_LIMIT=100  # requests per minute

# CORS Settings
ALLOWED_ORIGINS="*"  # Comma-separated list of allowed origins

# Database (future use)
# DATABASE_URL=postgresql://user:password@localhost:5432/candidate_ranking

# Cache (future use)
# REDIS_URL=redis://localhost:6379/0
# CACHE_TTL=3600  # seconds